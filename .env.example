# Used by "npm run dev". Copy to .env.local  (cp .env.example .env.local)
# .env.local is never committed.
NEXT_PUBLIC_API_URL=http://localhost:8080/api/v1
# Shows "Continue with Google". Set to true only when the backend has GOOGLE_CLIENT_ID and GOOGLE_CLIENT_SECRET.
NEXT_PUBLIC_GOOGLE_LOGIN_ENABLED=false
